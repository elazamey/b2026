{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "installCommand": "npm ci",
  "rewrites": [
    { "source": "/", "destination": "/api/plane?__path=/" },
    { "source": "/:path*", "destination": "/api/plane?__path=/:path*" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "X-Guardian-Writable", "value": "false" }
      ]
    }
  ]
}
