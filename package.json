{
  "name": "ai-guardian",
  "version": "0.5.0",
  "description": "AI Architecture & Engineering Guardian — deterministic verification and merge decisions for AI-generated changes.",
  "type": "module",
  "bin": {
    "ai-guardian": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "contracts",
    "action.yml",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsx src/cli.ts check",
    "test": "tsx --test tests/contract-engine.test.ts tests/scanners.test.ts tests/decision-engine.test.ts tests/cli.test.ts tests/ledger.test.ts tests/github-comment.test.ts tests/store.test.ts tests/loop.test.ts tests/agents.test.ts tests/gate.test.ts",
    "typecheck": "tsc --noEmit",
    "guardian": "tsx src/cli.ts check"
  },
  "keywords": [
    "architecture",
    "guardian",
    "static-analysis",
    "ci",
    "governance",
    "ai-engineering"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elazamey/b2026.git"
  },
  "dependencies": {
    "yaml": "^2.6.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
