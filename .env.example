# Optional Turso state ledger. Local `ai-guardian check` works without these.
# Never commit real credentials. Git is the source of truth for architecture.yaml.
# Production Control Plane: set the same names in the Vercel dashboard, not in Git.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# First matching register becomes platform_admin. Never a form field. Leave empty unless bootstrapping.
GUARDIAN_BOOTSTRAP_ADMIN_EMAIL=
